{
  "name": "masterclass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm gates && pnpm typecheck && pnpm test && pnpm build",
    "check:size": "node scripts/check-size.mjs",
    "check:deterministic": "node scripts/check-deterministic.mjs",
    "check:realtime": "node scripts/check-realtime.mjs",
    "check:signing": "node scripts/check-signing.mjs",
    "check:errors": "node scripts/check-errors.mjs",
    "gates": "pnpm check:size && pnpm check:deterministic && pnpm check:realtime && pnpm check:signing && pnpm check:errors",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/db/database.types.ts"
  },
  "dependencies": {
    "@mond-design-system/react": "6.6.0",
    "@mond-design-system/tokens": "4.3.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "supabase": "2.116.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "24.x"
  }
}
