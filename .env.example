# Copy to .env.local
PLATFORM_HOST=localhost

# fake | supabase
DATA_SOURCE=fake

# PayPal credential env per space: sandbox (default) | live. live only in production (G10).
PAYMENTS_ENV=sandbox

# Supabase project URL once wired (also widens CSP connect-src/img-src). Empty = fake data only.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase API keys (Dashboard > Project Settings > API Keys, or `supabase projects api-keys --reveal`).
# Copy the full key: the dashboard and the CLI without --reveal show a masked secret (with dots) that the API rejects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, bypasses RLS. Never expose, never commit.
SUPABASE_SECRET_KEY=

# Web push (VAPID). Generate once: `npx web-push generate-vapid-keys`. All three set = push on;
# all three empty = push off. Half set fails at startup. The public key is sent to the browser
# as a prop at request time, so it needs no NEXT_PUBLIC_ prefix.
VAPID_PUBLIC_KEY=
# Server only. Never expose, never commit.
VAPID_PRIVATE_KEY=
# mailto: or https:// contact the push services can reach.
VAPID_SUBJECT=

# Bearer secret for GET /api/cron/storage (storage cleanup). Server only, at least 32 chars:
# `openssl rand -hex 32`. Empty = the cron route refuses every call.
CRON_SECRET=
