# Copy to .env.local
PLATFORM_HOST=localhost

# fake | supabase
DATA_SOURCE=fake

# PayPal credential env per space: sandbox (default) | live. live only in production (G10).
PAYMENTS_ENV=sandbox

# Supabase project URL once wired (also widens CSP connect-src/img-src). Empty = fake data only.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase API keys (Dashboard > Project Settings > API Keys, or `supabase projects api-keys --reveal`).
# Copy the full key: the dashboard and the CLI without --reveal show a masked secret (with dots) that the API rejects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, bypasses RLS. Never expose, never commit.
SUPABASE_SECRET_KEY=
